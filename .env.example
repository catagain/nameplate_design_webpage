# =============================================================================
# 會議桌上名牌管理系統 — 環境設定檔範例
# 複製此檔案為 .env 並依實際環境修改設定
# =============================================================================

# 服務器端口號（預設: 3001）
# PORT=3001

# 服務器綁定地址（預設: 0.0.0.0，監聽所有網路介面）
# HOST=0.0.0.0

# 公開訪問基礎 URL（預設: 自動偵測，通常不需設定）
# 若需固定對外網址，可設為 http://your-domain:3001
# PUBLIC_BASE_URL=

# Philips 桌牌探索相關設定

# 設備探索 HTTP 請求超時（毫秒，預設: 900）
# DISCOVERY_TIMEOUT_MS=900

# 設備探索結果快取有效時間（毫秒，預設: 30000，即 30 秒）
# DISCOVERY_CACHE_MS=30000

# 設備探索並發請求數（預設: 24）
# DISCOVERY_CONCURRENCY=24

# 設備探索掃描端口（多個端口用逗號分隔，預設: 80）
# DISCOVERY_PORTS=80

# 對 Philips 桌牌發送請求的超時時間（毫秒，預設: 8000）
# PHILIPS_REQUEST_TIMEOUT_MS=8000
